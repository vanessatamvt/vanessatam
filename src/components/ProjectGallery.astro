---
// Horizontal-scroll project rail — the homepage's primary navigation,
// replicating the PRB reference site's Flickity carousel with plain CSS
// scroll-snap + a little vanilla JS for click-and-drag scrolling, no
// carousel library needed.
import ProjectCard from './ProjectCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;
---

<div class="project-gallery" data-view-panel="gallery">
  <div class="project-gallery__rail" data-gallery-rail tabindex="0" aria-label="Project gallery, scroll horizontally">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
  <nav class="project-gallery__nav container">
    <button class="project-gallery__arrow project-gallery__arrow--left" data-gallery-prev aria-label="Scroll left" disabled>&larr;</button>
    <ol class="project-gallery__dots" data-gallery-dots>
      {projects.map((_, i) => (
        <li><button type="button" data-gallery-dot={i} data-active={i === 0 ? '' : undefined} aria-label={`Go to project ${i + 1}`} /></li>
      ))}
    </ol>
    <button class="project-gallery__arrow project-gallery__arrow--right" data-gallery-next aria-label="Scroll right">&rarr;</button>
  </nav>
</div>

<style>
  .project-gallery__rail {
    display: flex;
    gap: var(--space-8);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    padding-inline: var(--container-padding);
    /* Without this, scroll-snap in Chromium snaps the first card's start
       edge to the scrollport edge *ignoring* the rail's own inline padding —
       so the page loads pre-scrolled past the left gutter, and the first
       card looks flush against the browser edge instead of inset. Matching
       scroll-padding-inline to the visual padding fixes the snap target. */
    scroll-padding-inline: var(--container-padding);
    padding-block: var(--space-8);
    cursor: grab;
    scrollbar-width: none;
    /* Press-and-drag on this rail means "scroll", so both browser defaults
       that would otherwise claim that gesture are suppressed: text selection
       (which paints a highlight across the captions mid-drag) and, below,
       native drag-and-drop. */
    user-select: none;
    -webkit-user-select: none;
  }

  /* Each card is an <a> wrapping an <img> — both natively draggable, so
     pressing on a project photo would start a ghost-image drag and the
     pointer never reaches the scroll handler. Firefox ignores this property,
     hence the dragstart guard in the script below as well. */
  .project-gallery__rail :global(a),
  .project-gallery__rail :global(img) {
    -webkit-user-drag: none;
  }

  .project-gallery__rail::-webkit-scrollbar {
    display: none;
  }

  .project-gallery__rail.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  .project-gallery__nav {
    display: none;
  }

  @media (pointer: fine) {
    .project-gallery__nav {
      display: flex;
      justify-content: space-between;
    }

    .project-gallery__arrow {
      font-size: var(--text-2xl);
      color: var(--color-accent);
      cursor: pointer;
      transition: color 160ms ease, opacity 200ms ease;
    }
    .project-gallery__arrow:hover:not([disabled]) {
      color: var(--color-accent-hover, var(--color-accent));
    }
    .project-gallery__arrow[disabled] {
      opacity: 0;
      pointer-events: none;
    }

    .project-gallery__dots {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .project-gallery__dots button {
      display: block;
      width: 1.5rem;
      height: 3px;
      background: var(--color-hairline);
      cursor: pointer;
      transition: background 160ms ease;
    }

    .project-gallery__dots button:hover {
      background: var(--color-muted);
    }

    .project-gallery__dots button[data-active] {
      background: var(--color-ink);
    }
  }
</style>

<script>
  const STORAGE_KEY = 'gallery-scroll-left';

  // Runs ONCE per real document load — Astro's ClientRouter swaps pages inside
  // the same document, so this does not re-run when navigating within the site.
  //
  // That distinction is the whole point: a remembered rail position should only
  // survive a trip into a project and back, never a fresh arrival. On a first
  // visit or a refresh the gallery must open on the newest work, so anything
  // left over from a previous session is cleared here. "back_forward" is left
  // alone — that IS the reader returning, which is what the memory is for.
  try {
    const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
    if (!nav || nav.type !== 'back_forward') sessionStorage.removeItem(STORAGE_KEY);
  } catch {
    // Private-browsing modes can throw on storage access; opening at the start
    // of the rail is the safe default anyway.
  }

  function bindGallery() {
    const rail = document.querySelector<HTMLElement>('[data-gallery-rail]');
    if (!rail) return;

    const prevArrow = document.querySelector<HTMLButtonElement>('[data-gallery-prev]');
    const nextArrow = document.querySelector<HTMLButtonElement>('[data-gallery-next]');
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-dot]'));
    const cards = Array.from(rail.querySelectorAll<HTMLElement>(':scope > *'));

    const getCardMetrics = () => {
      const card = cards[0];
      if (!card) return { width: 0, gap: 0 };
      const gap = parseFloat(getComputedStyle(rail).gap) || 0;
      return { width: card.offsetWidth, gap };
    };

    const getActiveIndex = () => {
      const { width, gap } = getCardMetrics();
      if (!width) return 0;
      return Math.round(rail.scrollLeft / (width + gap));
    };

    const updateControls = () => {
      if (prevArrow) prevArrow.disabled = rail.scrollLeft <= 10;
      if (nextArrow) nextArrow.disabled = rail.scrollLeft >= rail.scrollWidth - rail.clientWidth - 10;
      const active = getActiveIndex();
      dots.forEach((d, n) => d.toggleAttribute('data-active', n === active));
    };

    const scrollByCard = (dir: number) => {
      const { width, gap } = getCardMetrics();
      if (!width) return;
      rail.scrollBy({ left: dir * (width + gap), behavior: 'smooth' });
    };

    const scrollToCard = (index: number) => {
      const { width, gap } = getCardMetrics();
      if (!width) return;
      rail.scrollTo({ left: index * (width + gap), behavior: 'smooth' });
    };

    prevArrow?.addEventListener('click', () => scrollByCard(-1));
    nextArrow?.addEventListener('click', () => scrollByCard(1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => scrollToCard(i)));

    rail.addEventListener('scroll', () => requestAnimationFrame(updateControls), { passive: true });
    updateControls();

    // Horizontal navigation relies on native trackpad swipe and the
    // click-and-drag handler below — deliberately NOT hijacking the mouse
    // wheel here, since converting vertical wheel to horizontal scroll traps
    // the page (you'd have to scroll through all cards before the page
    // could continue past the gallery).
    // A real drag is only recognized after the pointer moves past a small
    // threshold. Capturing the pointer (and entering "dragging" state)
    // immediately on pointerdown — with no threshold — silently swallows
    // ordinary clicks on the project links inside each card, since pointer
    // capture reroutes the events a click is synthesized from.
    const DRAG_THRESHOLD = 6;

    // The cross-browser half of the -webkit-user-drag rule in the styles above
    // (Firefox ignores that property): without this, pressing and holding on a
    // card's photo starts the browser's own image/link drag — you get a
    // translucent copy of the photo following the cursor — and the pointermove
    // handler below never sees the gesture, so the rail doesn't scroll.
    rail.addEventListener('dragstart', (e) => e.preventDefault());

    let isDown = false;
    let dragging = false;
    let startX = 0;
    let startScroll = 0;

    rail.addEventListener('pointerdown', (e) => {
      isDown = true;
      dragging = false;
      startX = e.clientX;
      startScroll = rail.scrollLeft;
    });
    rail.addEventListener('pointermove', (e) => {
      if (!isDown) return;
      const dx = e.clientX - startX;
      if (!dragging && Math.abs(dx) > DRAG_THRESHOLD) {
        dragging = true;
        rail.classList.add('is-dragging');
        rail.setPointerCapture(e.pointerId);
      }
      if (dragging) {
        rail.scrollLeft = startScroll - dx;
      }
    });
    const stopDrag = () => {
      isDown = false;
      rail.classList.remove('is-dragging');
      // A drag that just ended still fires a trailing click on whatever's
      // under the pointer — suppress that one click so it can't accidentally
      // navigate, without affecting genuine taps/clicks.
      if (dragging) {
        const suppressNextClick = (e: MouseEvent) => {
          e.preventDefault();
          e.stopPropagation();
        };
        rail.addEventListener('click', suppressNextClick, { capture: true, once: true });
      }
      dragging = false;
    };
    rail.addEventListener('pointerup', stopDrag);
    rail.addEventListener('pointercancel', stopDrag);

    // ---- Remember where the rail was left ------------------------------
    // Clicking into a project and coming back re-renders the home page from
    // scratch, so the rail would otherwise snap back to card 01 and lose the
    // reader's place halfway down the gallery. The last position is stashed
    // per browser tab and put back on arrival.
    //
    // sessionStorage rather than localStorage on purpose: "where I was" should
    // survive navigating within a visit, but a visit tomorrow should open on
    // the first project rather than mid-reel with no memory of why.

    let saveFrame = 0;
    rail.addEventListener('scroll', () => {
      if (saveFrame) return;
      saveFrame = requestAnimationFrame(() => {
        saveFrame = 0;
        try {
          sessionStorage.setItem(STORAGE_KEY, String(rail.scrollLeft));
        } catch {
          // Private-browsing modes can throw on write; losing the position is
          // not worth breaking the gallery over.
        }
      });
    });

    let saved: string | null = null;
    try {
      saved = sessionStorage.getItem(STORAGE_KEY);
    } catch {
      saved = null;
    }
    if (saved) {
      const left = Number(saved);
      // Snapping fights an assignment made mid-layout, so it's suspended for
      // the one frame the restore happens in — same trick the drag uses.
      const restore = () => {
        rail.classList.add('is-dragging');
        rail.scrollLeft = left;
        requestAnimationFrame(() => rail.classList.remove('is-dragging'));
      };
      restore();
      // The cards carry explicit width/height so layout is stable immediately,
      // but fonts and the responsive image srcset can still settle a beat
      // later; re-applying once the page has fully loaded covers that.
      if (document.readyState !== 'complete') {
        window.addEventListener('load', restore, { once: true });
      }
    }
  }

  document.addEventListener('astro:page-load', bindGallery);
</script>
