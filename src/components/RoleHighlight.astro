---
// A distinct, accent-colored callout for what Vanessa personally did on a
// project (her PDF's "Responsibilities" line) — pulled out of the generic
// FactList so her own contribution reads as the headline it is, not just
// another row of project trivia.
interface Props {
  responsibilities?: string;
  details?: string[];
}
const { responsibilities, details } = Astro.props;
const items = (responsibilities ?? '')
  .split(',')
  .map((item) => item.trim())
  .filter(Boolean);
const detailItems = (details ?? []).filter(Boolean);
---

{
  items.length > 0 && (
    <section class="role-highlight">
      <div class="container">
        <p class="role-highlight__label">Vanessa's Role</p>
        <ul class="role-highlight__tags">
          {items.map((item) => (
            <li class="role-highlight__tag">{item}</li>
          ))}
        </ul>
        {detailItems.length > 0 && (
          <ul class="role-highlight__details">
            {detailItems.map((item) => (
              <li class="role-highlight__detail">{item}</li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}

<style>
  .role-highlight {
    padding-block: var(--space-12);
    border-bottom: var(--hairline-width) solid var(--color-hairline);
  }

  .role-highlight__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }

  .role-highlight__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
  }

  .role-highlight__tag {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--color-ink);
  }

  /* A small square accent-colored divider between items, in place of a
     comma — no pill/chip shape, no rounded corners, matching the site's
     square, hairline-based language rather than a UI-widget look. */
  .role-highlight__tag:not(:last-child)::after {
    content: '';
    display: inline-block;
    width: 0.35em;
    height: 0.35em;
    margin-inline: var(--space-4);
    background: var(--color-accent);
    vertical-align: middle;
  }

  /* The itemized task breakdown — one level down from the role tags above:
     body-copy size, muted color, same square accent marker (not a round
     bullet) so it echoes the tag divider instead of introducing a new shape. */
  .role-highlight__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-6);
    max-width: var(--text-measure);
  }

  .role-highlight__detail {
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--color-muted);
  }

  .role-highlight__detail::before {
    content: '';
    flex-shrink: 0;
    width: 0.35em;
    height: 0.35em;
    margin-top: 0.55em;
    background: var(--color-accent);
  }
</style>
