---
// Single-page flipbook with hard page flip animation.
// Each page fills the full container width for maximum readability.
// CSS 3D rotateY around the left edge (transform-origin: left center)
// gives a rigid page-turn — backface-visibility: hidden makes the
// turning page disappear past 90 degrees, revealing the next page
// underneath.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  pages: { src: ImageMetadata }[];
  title?: string;
}

const { pages, title } = Astro.props;
const numPages = pages.length;
const pageAR = pages[0]?.src ? pages[0].src.width / pages[0].src.height : 1.414;
---

{pages.length > 0 && (
  <section class="flipbook-section">
    <div class="container">
      {title && <h3 class="flipbook__title">{title}</h3>}

      <div class="flipbook" data-flipbook data-num-pages={numPages}>
        <div class="flipbook__book" style={`aspect-ratio:${pageAR}`}>
          {pages.map((page, i) => (
            <div class="flipbook__page" data-page={i}>
              <Image
                src={page.src}
                alt={`Page ${i + 1} of ${numPages}`}
                widths={[400, 640, 1024, 1600]}
                sizes="(min-width: 48rem) 88vw, 100vw"
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <span class="flipbook__shade" aria-hidden="true" />
            </div>
          ))}

          <button class="flipbook__zone flipbook__zone--left" data-prev
                  aria-label="Previous page" />
          <button class="flipbook__zone flipbook__zone--right" data-next
                  aria-label="Next page" />
        </div>

        <div class="flipbook__controls">
          <button class="flipbook__arrow" type="button" data-prev
                  aria-label="Previous page">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M15 4l-8 8 8 8" />
            </svg>
          </button>

          <div class="flipbook__slider" data-slider role="slider" tabindex="0"
               aria-label="Page" aria-valuemin="1"
               aria-valuemax={numPages} aria-valuenow="1">
            <span class="flipbook__rail" aria-hidden="true" />
            <span class="flipbook__fill" data-fill aria-hidden="true" />
            <span class="flipbook__ticks" aria-hidden="true">
              {Array.from({ length: numPages }, (_, i) => (
                <span class="flipbook__tick" data-tick data-index={i} />
              ))}
            </span>
            <span class="flipbook__knob" data-knob aria-hidden="true" />
          </div>

          <button class="flipbook__arrow" type="button" data-next
                  aria-label="Next page">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M9 4l8 8-8 8" />
            </svg>
          </button>
        </div>

        <p class="flipbook__count">
          <span data-count-label>1</span>&thinsp;/&thinsp;{numPages}
        </p>
      </div>
    </div>
  </section>
)}

<style>
  .flipbook-section { padding-block: var(--space-8); }

  .flipbook__title {
    margin-bottom: var(--space-4);
    font-family: var(--font-heading);
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--color-ink);
  }

  .flipbook__book {
    position: relative;
    width: 100%;
    perspective: 2000px;
    perspective-origin: 50% 50%;
    background: #fff;
    border: 1px solid var(--color-hairline);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }

  .flipbook__page {
    position: absolute;
    inset: 0;
    transform-origin: center center;
    backface-visibility: hidden;
    overflow: hidden;
    background: #fff;
    will-change: transform;
  }

  .flipbook__page :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .flipbook__shade {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.15), transparent 60%);
  }

  .flipbook__zone {
    position: absolute;
    top: 0;
    width: 50%;
    height: 100%;
    z-index: 60;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .flipbook__zone--left { left: 0; }
  .flipbook__zone--right { right: 0; }
  .flipbook__zone[disabled] { cursor: default; }

  .flipbook__page.is-flipping-forward {
    animation: flip-forward 700ms cubic-bezier(0.38, 0.01, 0.24, 1) forwards;
  }
  .flipbook__page.is-flipping-back {
    animation: flip-back 700ms cubic-bezier(0.38, 0.01, 0.24, 1) forwards;
  }

  .flipbook__page.is-flipping-forward .flipbook__shade {
    animation: shade-peak 700ms ease forwards;
  }

  @keyframes flip-forward {
    from { transform: rotateY(0deg); }
    to   { transform: rotateY(-180deg); }
  }
  @keyframes flip-back {
    from { transform: rotateY(-180deg); }
    to   { transform: rotateY(0deg); }
  }
  @keyframes shade-peak {
    0%   { opacity: 0; }
    50%  { opacity: 1; }
    100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .flipbook__page.is-flipping-forward,
    .flipbook__page.is-flipping-back,
    .flipbook__page.is-flipping-forward .flipbook__shade {
      animation-duration: 1ms;
    }
  }

  .flipbook__controls {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding-top: var(--space-6);
  }

  .flipbook__arrow {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--color-hairline);
    border-radius: 50%;
    background: none;
    cursor: pointer;
    color: var(--color-accent);
    transition: color 160ms ease, border-color 160ms ease, opacity 160ms ease;
  }
  .flipbook__arrow svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .flipbook__arrow:hover:not([disabled]) {
    color: var(--color-accent-hover);
    border-color: var(--color-accent);
  }
  .flipbook__arrow[disabled] {
    opacity: 0.3;
    cursor: default;
  }

  .flipbook__slider {
    position: relative;
    flex: 1 1 auto;
    height: 2.75rem;
    cursor: pointer;
    touch-action: none;
  }
  .flipbook__rail,
  .flipbook__fill {
    position: absolute;
    top: 50%;
    left: 0;
    height: 2px;
    transform: translateY(-50%);
  }
  .flipbook__rail {
    width: 100%;
    background: var(--color-hairline);
  }
  .flipbook__fill {
    width: 0;
    background: var(--color-accent);
    transition: width 200ms ease;
  }
  .flipbook__ticks {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .flipbook__tick {
    width: 1px;
    height: 7px;
    background: var(--color-hairline);
  }
  .flipbook__knob {
    position: absolute;
    top: 50%;
    left: 0;
    width: 0.75rem;
    height: 0.75rem;
    margin-left: -0.375rem;
    border-radius: 50%;
    background: var(--color-accent);
    transform: translateY(-50%);
    transition: left 200ms ease;
  }
  .flipbook__slider:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .flipbook.is-scrubbing .flipbook__fill,
  .flipbook.is-scrubbing .flipbook__knob {
    transition: none;
  }

  .flipbook__count {
    padding-top: var(--space-3);
    text-align: center;
    font-family: var(--font-mono, var(--font-body));
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-flipbook]').forEach((book) => {
      const pageEls = [...book.querySelectorAll<HTMLElement>('.flipbook__page')];
      const numPages = Number(book.dataset.numPages);
      const maxPage = numPages - 1;

      const label = book.querySelector<HTMLElement>('[data-count-label]');
      const fill = book.querySelector<HTMLElement>('[data-fill]');
      const knob = book.querySelector<HTMLElement>('[data-knob]');
      const slider = book.querySelector<HTMLElement>('[data-slider]');
      const prevBtns = [...book.querySelectorAll<HTMLButtonElement>('[data-prev]')];
      const nextBtns = [...book.querySelectorAll<HTMLButtonElement>('[data-next]')];

      let current = 0;
      let turning: { el: HTMLElement; target: number } | null = null;

      const setZ = () => {
        pageEls.forEach((el, i) => {
          el.style.zIndex = i < current ? '0' : String(numPages - i);
        });
      };

      const settle = () => {
        pageEls.forEach((el, i) => {
          el.style.transform = i < current ? 'rotateY(-180deg)' : 'rotateY(0deg)';
          if (Math.abs(i - current) <= 1) {
            el.querySelectorAll<HTMLImageElement>('img[loading="lazy"]')
              .forEach((img) => { img.loading = 'eager'; });
          }
        });
        setZ();
      };

      const paintChrome = (shown: number) => {
        if (label) label.textContent = String(shown + 1);
        const pct = maxPage > 0 ? (shown / maxPage) * 100 : 0;
        if (fill) fill.style.width = `${pct}%`;
        if (knob) knob.style.left = `${pct}%`;
        slider?.setAttribute('aria-valuenow', String(shown + 1));
        prevBtns.forEach((b) => { b.disabled = shown === 0; });
        nextBtns.forEach((b) => { b.disabled = shown >= maxPage; });
      };

      const finishTurn = () => {
        if (!turning) return;
        const { el, target } = turning;
        current = target;
        turning = null;
        settle();
        el.classList.remove('is-flipping-forward', 'is-flipping-back');
        paintChrome(current);
      };

      const flipTo = (target: number, animate: boolean) => {
        const next = Math.max(0, Math.min(target, maxPage));
        finishTurn();
        if (next === current) return;

        if (!animate || Math.abs(next - current) !== 1) {
          current = next;
          settle();
          paintChrome(current);
          return;
        }

        const forward = next > current;
        const idx = forward ? current : current - 1;
        const el = pageEls[idx];

        el.style.zIndex = String(numPages + 1);
        el.style.transform = '';
        el.classList.add(forward ? 'is-flipping-forward' : 'is-flipping-back');
        turning = { el, target: next };
        paintChrome(next);

        if (idx + 1 < numPages) {
          pageEls[idx + 1].querySelectorAll<HTMLImageElement>('img[loading="lazy"]')
            .forEach((img) => { img.loading = 'eager'; });
        }

        const ref = turning;
        el.onanimationend = (e: AnimationEvent) => {
          if (e.target !== el) return;
          if (turning === ref) finishTurn();
        };
        setTimeout(() => { if (turning === ref) finishTurn(); }, 900);
      };

      const step = (d: number) => {
        flipTo((turning ? turning.target : current) + d, true);
      };

      prevBtns.forEach((b) => b.addEventListener('click', () => step(-1)));
      nextBtns.forEach((b) => b.addEventListener('click', () => step(1)));

      book.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
        if (e.key === 'Home') { e.preventDefault(); flipTo(0, false); }
        if (e.key === 'End') { e.preventDefault(); flipTo(maxPage, false); }
      });

      if (slider) {
        const posAt = (cx: number) => {
          const r = slider.getBoundingClientRect();
          const t = Math.max(0, Math.min((cx - r.left) / r.width, 1));
          return Math.round(t * maxPage);
        };
        let scrubbing = false;
        slider.addEventListener('pointerdown', (e: PointerEvent) => {
          scrubbing = true;
          book.classList.add('is-scrubbing');
          slider.setPointerCapture(e.pointerId);
          flipTo(posAt(e.clientX), false);
        });
        slider.addEventListener('pointermove', (e: PointerEvent) => {
          if (scrubbing) flipTo(posAt(e.clientX), false);
        });
        const stop = () => {
          scrubbing = false;
          book.classList.remove('is-scrubbing');
        };
        slider.addEventListener('pointerup', stop);
        slider.addEventListener('pointercancel', stop);
      }

      let sx = 0, sy = 0;
      book.addEventListener('touchstart', (e: TouchEvent) => {
        sx = e.touches[0].clientX;
        sy = e.touches[0].clientY;
      }, { passive: true });
      book.addEventListener('touchend', (e: TouchEvent) => {
        const dx = e.changedTouches[0].clientX - sx;
        const dy = e.changedTouches[0].clientY - sy;
        if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) step(dx < 0 ? 1 : -1);
      }, { passive: true });

      settle();
      paintChrome(current);
    });
  });
</script>
