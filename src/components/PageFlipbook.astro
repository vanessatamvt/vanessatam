---
// Two-page spread flipbook with hard page flip around a center spine.
// Pages are paired into sheets: each sheet has a front (right-side page) and
// a back (left-side page once the sheet is turned). CSS 3D rotateY around
// the spine (transform-origin: left center on the right-half-positioned sheet)
// gives a rigid page-turn that matches the StPageFlip "hard" mode.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  pages: { src: ImageMetadata }[];
  title?: string;
}

const { pages, title } = Astro.props;

const sheets: { front: ImageMetadata; back: ImageMetadata | null }[] = [];
for (let i = 0; i < pages.length; i += 2) {
  sheets.push({
    front: pages[i].src,
    back: i + 1 < pages.length ? pages[i + 1].src : null,
  });
}

const numSheets = sheets.length;
const lastHasBack = numSheets > 0 && !!sheets[numSheets - 1].back;
const maxTurned = lastHasBack ? numSheets : Math.max(numSheets - 1, 0);
const totalPositions = maxTurned + 1;
const pageAR = pages[0]?.src ? pages[0].src.width / pages[0].src.height : 1.414;
const spreadAR = 2 * pageAR;
---

{pages.length > 0 && (
  <section class="flipbook-section">
    <div class="container">
      {title && <h3 class="flipbook__title">{title}</h3>}

      <div class="flipbook" data-flipbook data-num-sheets={numSheets}
           data-max-turned={maxTurned} data-total-pages={pages.length}>
        <div class="flipbook__book" style={`aspect-ratio:${spreadAR}`}>
          <div class="flipbook__endpaper flipbook__endpaper--left" aria-hidden="true" />
          <div class="flipbook__endpaper flipbook__endpaper--right" aria-hidden="true" />

          {sheets.map((sheet, i) => (
            <div class="flipbook__sheet" data-sheet={i}>
              <div class="flipbook__face flipbook__face--front">
                <Image
                  src={sheet.front}
                  alt={`Page ${i * 2 + 1} of ${pages.length}`}
                  widths={[400, 640, 1024, 1600]}
                  sizes="(min-width: 48rem) 44vw, 50vw"
                  loading={i < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
                <span class="flipbook__shade" aria-hidden="true" />
              </div>
              <div class="flipbook__face flipbook__face--back">
                {sheet.back ? (
                  <Image
                    src={sheet.back}
                    alt={`Page ${i * 2 + 2} of ${pages.length}`}
                    widths={[400, 640, 1024, 1600]}
                    sizes="(min-width: 48rem) 44vw, 50vw"
                    loading={i < 2 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                ) : (
                  <div class="flipbook__blank" />
                )}
                <span class="flipbook__shade" aria-hidden="true" />
              </div>
            </div>
          ))}

          <div class="flipbook__spine" aria-hidden="true" />
          <button class="flipbook__zone flipbook__zone--left" data-prev
                  aria-label="Previous spread" />
          <button class="flipbook__zone flipbook__zone--right" data-next
                  aria-label="Next spread" />
        </div>

        <div class="flipbook__controls">
          <button class="flipbook__arrow" type="button" data-prev
                  aria-label="Previous spread">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M15 4l-8 8 8 8" />
            </svg>
          </button>

          <div class="flipbook__slider" data-slider role="slider" tabindex="0"
               aria-label="Spread" aria-valuemin="1"
               aria-valuemax={totalPositions} aria-valuenow="1">
            <span class="flipbook__rail" aria-hidden="true" />
            <span class="flipbook__fill" data-fill aria-hidden="true" />
            <span class="flipbook__ticks" aria-hidden="true">
              {Array.from({ length: totalPositions }, (_, i) => (
                <span class="flipbook__tick" data-tick data-index={i} />
              ))}
            </span>
            <span class="flipbook__knob" data-knob aria-hidden="true" />
          </div>

          <button class="flipbook__arrow" type="button" data-next
                  aria-label="Next spread">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M9 4l8 8-8 8" />
            </svg>
          </button>
        </div>

        <p class="flipbook__count">
          <span data-count-label>1</span>&thinsp;/&thinsp;{pages.length}
        </p>
      </div>
    </div>
  </section>
)}

<style>
  .flipbook-section { padding-block: var(--space-8); }

  .flipbook__title {
    margin-bottom: var(--space-4);
    font-family: var(--font-heading);
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--color-ink);
  }

  .flipbook__book {
    position: relative;
    width: 100%;
    perspective: 2000px;
    perspective-origin: 50% 50%;
    background: #fff;
    border: 1px solid var(--color-hairline);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }

  .flipbook__endpaper {
    position: absolute;
    top: 0;
    width: 50%;
    height: 100%;
    z-index: 0;
  }
  .flipbook__endpaper--left {
    left: 0;
    background: linear-gradient(to right, #eae3d4, #efe9db);
  }
  .flipbook__endpaper--right {
    right: 0;
    background: linear-gradient(to left, #eae3d4, #efe9db);
  }

  .flipbook__sheet {
    position: absolute;
    top: 0;
    left: 50%;
    width: 50%;
    height: 100%;
    transform-origin: left center;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .flipbook__face--front,
  .flipbook__face--back {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    overflow: hidden;
    background: #fff;
  }
  .flipbook__face--back {
    transform: rotateY(180deg);
  }

  .flipbook__face--front :global(img),
  .flipbook__face--back :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .flipbook__blank {
    width: 100%;
    height: 100%;
    background: #fff;
  }

  .flipbook__shade {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }
  .flipbook__face--front .flipbook__shade {
    background: linear-gradient(to right, rgba(0, 0, 0, 0.25), transparent 50%);
  }
  .flipbook__face--back .flipbook__shade {
    background: linear-gradient(to left, rgba(0, 0, 0, 0.25), transparent 50%);
  }

  .flipbook__spine {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 8px;
    transform: translateX(-50%);
    background: linear-gradient(
      to right,
      transparent,
      rgba(0, 0, 0, 0.04) 25%,
      rgba(0, 0, 0, 0.10) 50%,
      rgba(0, 0, 0, 0.04) 75%,
      transparent
    );
    z-index: 50;
    pointer-events: none;
  }

  .flipbook__zone {
    position: absolute;
    top: 0;
    width: 50%;
    height: 100%;
    z-index: 60;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .flipbook__zone--left { left: 0; }
  .flipbook__zone--right { right: 0; }
  .flipbook__zone[disabled] { cursor: default; }

  .flipbook__sheet.is-flipping-forward {
    animation: flip-forward 700ms cubic-bezier(0.38, 0.01, 0.24, 1) forwards;
  }
  .flipbook__sheet.is-flipping-back {
    animation: flip-back 700ms cubic-bezier(0.38, 0.01, 0.24, 1) forwards;
  }

  .flipbook__sheet.is-flipping-forward .flipbook__face--front .flipbook__shade,
  .flipbook__sheet.is-flipping-back .flipbook__face--back .flipbook__shade {
    animation: shade-peak 700ms ease forwards;
  }

  @keyframes flip-forward {
    from { transform: rotateY(0deg); }
    to   { transform: rotateY(-180deg); }
  }
  @keyframes flip-back {
    from { transform: rotateY(-180deg); }
    to   { transform: rotateY(0deg); }
  }
  @keyframes shade-peak {
    0%   { opacity: 0; }
    50%  { opacity: 1; }
    100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .flipbook__sheet.is-flipping-forward,
    .flipbook__sheet.is-flipping-back,
    .flipbook__sheet.is-flipping-forward .flipbook__shade,
    .flipbook__sheet.is-flipping-back .flipbook__shade {
      animation-duration: 1ms;
    }
  }

  .flipbook__controls {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding-top: var(--space-6);
  }

  .flipbook__arrow {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--color-hairline);
    border-radius: 50%;
    background: none;
    cursor: pointer;
    color: var(--color-accent);
    transition: color 160ms ease, border-color 160ms ease, opacity 160ms ease;
  }
  .flipbook__arrow svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .flipbook__arrow:hover:not([disabled]) {
    color: var(--color-accent-hover);
    border-color: var(--color-accent);
  }
  .flipbook__arrow[disabled] {
    opacity: 0.3;
    cursor: default;
  }

  .flipbook__slider {
    position: relative;
    flex: 1 1 auto;
    height: 2.75rem;
    cursor: pointer;
    touch-action: none;
  }
  .flipbook__rail,
  .flipbook__fill {
    position: absolute;
    top: 50%;
    left: 0;
    height: 2px;
    transform: translateY(-50%);
  }
  .flipbook__rail {
    width: 100%;
    background: var(--color-hairline);
  }
  .flipbook__fill {
    width: 0;
    background: var(--color-accent);
    transition: width 200ms ease;
  }
  .flipbook__ticks {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .flipbook__tick {
    width: 1px;
    height: 7px;
    background: var(--color-hairline);
  }
  .flipbook__knob {
    position: absolute;
    top: 50%;
    left: 0;
    width: 0.75rem;
    height: 0.75rem;
    margin-left: -0.375rem;
    border-radius: 50%;
    background: var(--color-accent);
    transform: translateY(-50%);
    transition: left 200ms ease;
  }
  .flipbook__slider:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .flipbook.is-scrubbing .flipbook__fill,
  .flipbook.is-scrubbing .flipbook__knob {
    transition: none;
  }

  .flipbook__count {
    padding-top: var(--space-3);
    text-align: center;
    font-family: var(--font-mono, var(--font-body));
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-flipbook]').forEach((book) => {
      const sheetEls = [...book.querySelectorAll<HTMLElement>('.flipbook__sheet')];
      const numSheets = Number(book.dataset.numSheets);
      const maxTurned = Number(book.dataset.maxTurned);
      const totalPages = Number(book.dataset.totalPages);
      const totalPos = maxTurned + 1;

      const label = book.querySelector<HTMLElement>('[data-count-label]');
      const fill = book.querySelector<HTMLElement>('[data-fill]');
      const knob = book.querySelector<HTMLElement>('[data-knob]');
      const slider = book.querySelector<HTMLElement>('[data-slider]');
      const prevBtns = [...book.querySelectorAll<HTMLButtonElement>('[data-prev]')];
      const nextBtns = [...book.querySelectorAll<HTMLButtonElement>('[data-next]')];

      let turned = 0;
      let turning: { el: HTMLElement; target: number } | null = null;

      const setZ = () => {
        sheetEls.forEach((el, i) => {
          el.style.zIndex = String(i < turned ? i + 1 : turned + numSheets - i);
        });
      };

      const settle = () => {
        sheetEls.forEach((el, i) => {
          el.style.transform = i < turned ? 'rotateY(-180deg)' : 'rotateY(0deg)';
          if (Math.abs(i - turned) <= 1) {
            el.querySelectorAll<HTMLImageElement>('img[loading="lazy"]')
              .forEach((img) => { img.loading = 'eager'; });
          }
        });
        setZ();
      };

      const paintChrome = (shown: number) => {
        if (label) {
          if (shown === 0) {
            label.textContent = '1';
          } else {
            const l = shown * 2;
            const r = l + 1;
            label.textContent = r <= totalPages
              ? `${l} – ${r}` : String(l);
          }
        }
        const pct = totalPos > 1 ? (shown / (totalPos - 1)) * 100 : 0;
        if (fill) fill.style.width = `${pct}%`;
        if (knob) knob.style.left = `${pct}%`;
        slider?.setAttribute('aria-valuenow', String(shown + 1));
        prevBtns.forEach((b) => { b.disabled = shown === 0; });
        nextBtns.forEach((b) => { b.disabled = shown >= maxTurned; });
      };

      const finishTurn = () => {
        if (!turning) return;
        const { el, target } = turning;
        turned = target;
        turning = null;
        settle();
        el.classList.remove('is-flipping-forward', 'is-flipping-back');
        paintChrome(turned);
      };

      const flipTo = (target: number, animate: boolean) => {
        const next = Math.max(0, Math.min(target, maxTurned));
        finishTurn();
        if (next === turned) return;

        if (!animate || Math.abs(next - turned) !== 1) {
          turned = next;
          settle();
          paintChrome(turned);
          return;
        }

        const forward = next > turned;
        const idx = forward ? turned : turned - 1;
        const el = sheetEls[idx];

        el.style.zIndex = String(2 * numSheets + 1);
        el.style.transform = '';
        el.classList.add(forward ? 'is-flipping-forward' : 'is-flipping-back');
        turning = { el, target: next };
        paintChrome(next);

        if (idx + 1 < numSheets) {
          sheetEls[idx + 1].querySelectorAll<HTMLImageElement>('img[loading="lazy"]')
            .forEach((img) => { img.loading = 'eager'; });
        }

        const ref = turning;
        el.onanimationend = (e: AnimationEvent) => {
          if (e.target !== el) return;
          if (turning === ref) finishTurn();
        };
        setTimeout(() => { if (turning === ref) finishTurn(); }, 900);
      };

      const step = (d: number) => {
        flipTo((turning ? turning.target : turned) + d, true);
      };

      prevBtns.forEach((b) => b.addEventListener('click', () => step(-1)));
      nextBtns.forEach((b) => b.addEventListener('click', () => step(1)));

      book.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
        if (e.key === 'Home') { e.preventDefault(); flipTo(0, false); }
        if (e.key === 'End') { e.preventDefault(); flipTo(maxTurned, false); }
      });

      if (slider) {
        const posAt = (cx: number) => {
          const r = slider.getBoundingClientRect();
          const t = Math.max(0, Math.min((cx - r.left) / r.width, 1));
          return Math.round(t * maxTurned);
        };
        let scrubbing = false;
        slider.addEventListener('pointerdown', (e: PointerEvent) => {
          scrubbing = true;
          book.classList.add('is-scrubbing');
          slider.setPointerCapture(e.pointerId);
          flipTo(posAt(e.clientX), false);
        });
        slider.addEventListener('pointermove', (e: PointerEvent) => {
          if (scrubbing) flipTo(posAt(e.clientX), false);
        });
        const stop = () => {
          scrubbing = false;
          book.classList.remove('is-scrubbing');
        };
        slider.addEventListener('pointerup', stop);
        slider.addEventListener('pointercancel', stop);
      }

      let sx = 0, sy = 0;
      book.addEventListener('touchstart', (e: TouchEvent) => {
        sx = e.touches[0].clientX;
        sy = e.touches[0].clientY;
      }, { passive: true });
      book.addEventListener('touchend', (e: TouchEvent) => {
        const dx = e.changedTouches[0].clientX - sx;
        const dy = e.changedTouches[0].clientY - sy;
        if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) step(dx < 0 ? 1 : -1);
      }, { passive: true });

      settle();
      paintChrome(turned);
    });
  });
</script>
