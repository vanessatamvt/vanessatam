---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  pages: { src: ImageMetadata }[];
  title?: string;
}

const { pages, title } = Astro.props;
const numPages = pages.length;
const pageAR = pages[0]?.src ? pages[0].src.width / pages[0].src.height : 1.414;
---

{pages.length > 0 && (
  <section class="slider-section">
    <div class="container">
      {title && <h3 class="slider__title">{title}</h3>}

      <div class="slider" data-slider-book data-num-pages={numPages}>
        <div class="slider__stage" style={`aspect-ratio:${pageAR}`}>
          <div class="slider__track-inner" data-track-inner>
            {pages.map((page, i) => (
              <div class="slider__page" data-page={i}>
                <Image
                  src={page.src}
                  alt={`Page ${i + 1} of ${numPages}`}
                  widths={[400, 640, 1024, 1600]}
                  sizes="(min-width: 48rem) 88vw, 100vw"
                  loading={i < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
            ))}
          </div>

          <button class="slider__zone slider__zone--left" data-prev
                  aria-label="Previous page" />
          <button class="slider__zone slider__zone--right" data-next
                  aria-label="Next page" />
        </div>

        <div class="slider__controls">
          <button class="slider__arrow" type="button" data-prev
                  aria-label="Previous page">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M15 4l-8 8 8 8" />
            </svg>
          </button>

          <div class="slider__nav" data-nav role="slider" tabindex="0"
               aria-label="Page" aria-valuemin="1"
               aria-valuemax={numPages} aria-valuenow="1">
            <span class="slider__rail" aria-hidden="true" />
            <span class="slider__fill" data-fill aria-hidden="true" />
            <span class="slider__ticks" aria-hidden="true">
              {Array.from({ length: numPages }, (_, i) => (
                <span class="slider__tick" data-tick data-index={i} />
              ))}
            </span>
            <span class="slider__knob" data-knob aria-hidden="true" />
          </div>

          <button class="slider__arrow" type="button" data-next
                  aria-label="Next page">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M9 4l8 8-8 8" />
            </svg>
          </button>
        </div>

        <p class="slider__count">
          <span data-count-label>1</span>&thinsp;/&thinsp;{numPages}
        </p>
      </div>
    </div>
  </section>
)}

<style>
  .slider-section { padding-block: var(--space-8); }

  .slider__title {
    margin-bottom: var(--space-4);
    font-family: var(--font-heading);
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--color-ink);
  }

  .slider__stage {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .slider__track-inner {
    display: flex;
    height: 100%;
    transition: transform 600ms cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  .slider__page {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
  }

  .slider__page :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .slider__zone {
    position: absolute;
    top: 0;
    width: 50%;
    height: 100%;
    z-index: 10;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .slider__zone--left { left: 0; }
  .slider__zone--right { right: 0; }
  .slider__zone[disabled] { cursor: default; }

  @media (prefers-reduced-motion: reduce) {
    .slider__track-inner {
      transition-duration: 1ms;
    }
  }

  .slider__controls {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding-top: var(--space-6);
  }

  .slider__arrow {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--color-hairline);
    border-radius: 50%;
    background: none;
    cursor: pointer;
    color: var(--color-accent);
    transition: color 160ms ease, border-color 160ms ease, opacity 160ms ease;
  }
  .slider__arrow svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .slider__arrow:hover:not([disabled]) {
    color: var(--color-accent-hover);
    border-color: var(--color-accent);
  }
  .slider__arrow[disabled] {
    opacity: 0.3;
    cursor: default;
  }

  .slider__nav {
    position: relative;
    flex: 1 1 auto;
    height: 2.75rem;
    cursor: pointer;
    touch-action: none;
  }
  .slider__rail,
  .slider__fill {
    position: absolute;
    top: 50%;
    left: 0;
    height: 2px;
    transform: translateY(-50%);
  }
  .slider__rail {
    width: 100%;
    background: var(--color-hairline);
  }
  .slider__fill {
    width: 0;
    background: var(--color-accent);
    transition: width 200ms ease;
  }
  .slider__ticks {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .slider__tick {
    width: 1px;
    height: 7px;
    background: var(--color-hairline);
  }
  .slider__knob {
    position: absolute;
    top: 50%;
    left: 0;
    width: 0.75rem;
    height: 0.75rem;
    margin-left: -0.375rem;
    border-radius: 50%;
    background: var(--color-accent);
    transform: translateY(-50%);
    transition: left 200ms ease;
  }
  .slider__nav:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .slider.is-scrubbing .slider__fill,
  .slider.is-scrubbing .slider__knob {
    transition: none;
  }

  .slider__count {
    padding-top: var(--space-3);
    text-align: center;
    font-family: var(--font-mono, var(--font-body));
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-slider-book]').forEach((book) => {
      const trackInner = book.querySelector<HTMLElement>('[data-track-inner]')!;
      const pageEls = [...book.querySelectorAll<HTMLElement>('.slider__page')];
      const numPages = Number(book.dataset.numPages);
      const maxPage = numPages - 1;

      const label = book.querySelector<HTMLElement>('[data-count-label]');
      const fill = book.querySelector<HTMLElement>('[data-fill]');
      const knob = book.querySelector<HTMLElement>('[data-knob]');
      const nav = book.querySelector<HTMLElement>('[data-nav]');
      const prevBtns = [...book.querySelectorAll<HTMLButtonElement>('[data-prev]')];
      const nextBtns = [...book.querySelectorAll<HTMLButtonElement>('[data-next]')];

      let current = 0;

      const slide = (index: number) => {
        trackInner.style.transform = `translateX(-${index * 100}%)`;
        pageEls.forEach((el, i) => {
          if (Math.abs(i - index) <= 1) {
            el.querySelectorAll<HTMLImageElement>('img[loading="lazy"]')
              .forEach((img) => { img.loading = 'eager'; });
          }
        });
      };

      const paintChrome = (shown: number) => {
        if (label) label.textContent = String(shown + 1);
        const pct = maxPage > 0 ? (shown / maxPage) * 100 : 0;
        if (fill) fill.style.width = `${pct}%`;
        if (knob) knob.style.left = `${pct}%`;
        nav?.setAttribute('aria-valuenow', String(shown + 1));
        prevBtns.forEach((b) => { b.disabled = shown === 0; });
        nextBtns.forEach((b) => { b.disabled = shown >= maxPage; });
      };

      const goTo = (target: number) => {
        const next = Math.max(0, Math.min(target, maxPage));
        if (next === current) return;
        current = next;
        slide(current);
        paintChrome(current);
      };

      const step = (d: number) => goTo(current + d);

      prevBtns.forEach((b) => b.addEventListener('click', () => step(-1)));
      nextBtns.forEach((b) => b.addEventListener('click', () => step(1)));

      book.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
        if (e.key === 'Home') { e.preventDefault(); goTo(0); }
        if (e.key === 'End') { e.preventDefault(); goTo(maxPage); }
      });

      if (nav) {
        const posAt = (cx: number) => {
          const r = nav.getBoundingClientRect();
          const t = Math.max(0, Math.min((cx - r.left) / r.width, 1));
          return Math.round(t * maxPage);
        };
        let scrubbing = false;
        nav.addEventListener('pointerdown', (e: PointerEvent) => {
          scrubbing = true;
          book.classList.add('is-scrubbing');
          nav.setPointerCapture(e.pointerId);
          goTo(posAt(e.clientX));
        });
        nav.addEventListener('pointermove', (e: PointerEvent) => {
          if (scrubbing) goTo(posAt(e.clientX));
        });
        const stop = () => {
          scrubbing = false;
          book.classList.remove('is-scrubbing');
        };
        nav.addEventListener('pointerup', stop);
        nav.addEventListener('pointercancel', stop);
      }

      let sx = 0, sy = 0;
      book.addEventListener('touchstart', (e: TouchEvent) => {
        sx = e.touches[0].clientX;
        sy = e.touches[0].clientY;
      }, { passive: true });
      book.addEventListener('touchend', (e: TouchEvent) => {
        const dx = e.changedTouches[0].clientX - sx;
        const dy = e.changedTouches[0].clientY - sy;
        if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) step(dx < 0 ? 1 : -1);
      }, { passive: true });

      slide(current);
      paintChrome(current);
    });
  });
</script>
