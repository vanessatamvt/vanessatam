---
// An issuu-style page-turner for a run of book pages — used where a project
// carries a whole exported booklet and stacking eighteen full-width scans down
// the page would bury the rest of the project.
//
// Every page is rendered up front and stacked absolutely inside one stage, so
// turning never reflows the page; only the turning leaf moves. The stage sits
// inside a frame with its own margin, so the current page reads as a sheet
// centred on the page rather than a full-bleed band.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  pages: { src: ImageMetadata }[];
  title?: string;
  /** Aspect ratio of the stage, w/h. Defaults to the commonest page shape in
   *  the run, so the stage fits the majority of pages exactly. */
  ratio?: number;
}
const { pages, title, ratio } = Astro.props;
const counts = new Map<number, number>();
for (const p of pages) {
  const r = Math.round((p.src.width / p.src.height) * 100) / 100;
  counts.set(r, (counts.get(r) ?? 0) + 1);
}
const commonest = [...counts.entries()].sort((a, b) => b[1] - a[1])[0]?.[0] ?? 1.414;
const stageRatio = ratio ?? commonest;
const pad = (n: number) => String(n).padStart(2, '0');
---

{
  pages.length > 0 && (
    <section class="flipbook-section">
      <div class="container">
        {title && <h3 class="flipbook__title">{title}</h3>}

        <div class="flipbook" data-flipbook data-count={pages.length}>
          <div class="flipbook__frame">
            <div class="flipbook__stage" style={`aspect-ratio:${stageRatio}`}>
              {pages.map((p, i) => (
                <div class="flipbook__page" data-page={i} data-state={i === 0 ? 'current' : 'after'}>
                  {/* The leaf is what rotates. It's two-sided: the scan on the
                      front, blank stock behind, so past 90° you see the back
                      of the sheet swinging over rather than the page blinking
                      out. */}
                  <div class="flipbook__leaf">
                    <div class="flipbook__face">
                      <Image
                        src={p.src}
                        alt={`Page ${i + 1} of ${pages.length}`}
                        widths={[640, 1024, 1600, 2400]}
                        sizes="(min-width: 48rem) 88vw, 100vw"
                        loading={i < 2 ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                      <span class="flipbook__shade" aria-hidden="true" />
                    </div>
                    <div class="flipbook__back" aria-hidden="true" />
                  </div>
                </div>
              ))}

              <button class="flipbook__edge flipbook__edge--prev" data-prev aria-label="Previous page" />
              <button class="flipbook__edge flipbook__edge--next" data-next aria-label="Next page" />
            </div>
          </div>

          {/* Arrows either side of a scrubbable track, after the photo
              journal's chapter controls. */}
          <div class="flipbook__controls">
            <button class="flipbook__arrow" type="button" data-prev aria-label="Previous page">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 4l-8 8 8 8" /></svg>
            </button>

            <div
              class="flipbook__slider"
              data-slider
              role="slider"
              tabindex="0"
              aria-label="Page"
              aria-valuemin="1"
              aria-valuemax={pages.length}
              aria-valuenow="1"
            >
              <span class="flipbook__rail" aria-hidden="true" />
              <span class="flipbook__fill" data-fill aria-hidden="true" />
              <span class="flipbook__ticks" aria-hidden="true">
                {pages.map((_, i) => (
                  <span class="flipbook__tick" data-tick data-index={i} />
                ))}
              </span>
              <span class="flipbook__knob" data-knob aria-hidden="true" />
            </div>

            <button class="flipbook__arrow" type="button" data-next aria-label="Next page">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 4l8 8-8 8" /></svg>
            </button>
          </div>

          <p class="flipbook__count">
            <span data-count-label>{pad(1)}</span> / {pad(pages.length)}
          </p>
        </div>
      </div>
    </section>
  )
}

<style>
  .flipbook-section {
    padding-block: var(--space-8);
  }

  .flipbook__title {
    margin-bottom: var(--space-4);
    font-family: var(--font-heading);
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--color-ink);
  }

  /* The frame IS the sheet. Its ground is the same white the scanned pages
     are printed on, so the page's own white runs out to the border instead of
     stopping short against the site's cream — the margin reads as the paper's
     margin rather than a gap around a pasted-in image. */
  .flipbook__frame {
    --flipbook-paper: #fff;
    padding: clamp(var(--space-4), 3vw, var(--space-12));
    background: var(--flipbook-paper);
    border: 1px solid var(--color-hairline);
  }

  /* Anything the contain-fit leaves over at the stage edge is paper too, so a
     page whose proportions differ a hair from the stage can't show a seam. */
  .flipbook__stage,
  .flipbook__face {
    background: var(--flipbook-paper);
  }

  /* Perspective is anchored at the spine so a turning sheet recedes the way a
     real page does instead of scaling uniformly. */
  .flipbook__stage {
    position: relative;
    width: 100%;
    perspective: 2400px;
    perspective-origin: left center;
  }

  .flipbook__page {
    position: absolute;
    inset: 0;
  }

  .flipbook__leaf {
    position: absolute;
    inset: 0;
    transform-origin: left center;
    transform-style: preserve-3d;
  }

  .flipbook__face,
  .flipbook__back {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
  }

  .flipbook__face :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .flipbook__back {
    transform: rotateY(180deg);
    background: linear-gradient(to left, #efe9db 0%, #e4dccb 55%, #d9d0bd 100%);
  }

  .flipbook__shade {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    background: linear-gradient(to left, rgba(28, 26, 22, 0) 55%, rgba(28, 26, 22, 0.42) 100%);
  }

  .flipbook__page[data-state='after'],
  .flipbook__page[data-state='before'] {
    z-index: 1;
    visibility: hidden;
  }

  .flipbook__page[data-state='current'] {
    z-index: 2;
  }

  .flipbook__page[data-state='before'] .flipbook__leaf {
    transform: rotateY(-180deg);
  }

  /* The turn: slow enough to read as paper, unhurried at both ends and
     quickest through the middle, which is how a turned page actually moves. */
  .flipbook__page[data-turning] {
    z-index: 5;
    visibility: visible;
  }

  .flipbook__page[data-turning='forward'] .flipbook__leaf {
    animation: leaf-forward 1150ms cubic-bezier(0.62, 0.02, 0.36, 1) forwards;
  }

  .flipbook__page[data-turning='back'] .flipbook__leaf {
    animation: leaf-back 1150ms cubic-bezier(0.62, 0.02, 0.36, 1) forwards;
  }

  .flipbook__page[data-turning='forward'] .flipbook__shade {
    animation: shade-forward 1150ms cubic-bezier(0.62, 0.02, 0.36, 1) forwards;
  }

  .flipbook__page[data-turning='back'] .flipbook__shade {
    animation: shade-back 1150ms cubic-bezier(0.62, 0.02, 0.36, 1) forwards;
  }

  @keyframes leaf-forward {
    from { transform: rotateY(0deg); }
    to { transform: rotateY(-180deg); }
  }

  @keyframes leaf-back {
    from { transform: rotateY(-180deg); }
    to { transform: rotateY(0deg); }
  }

  @keyframes shade-forward {
    0% { opacity: 0; }
    70% { opacity: 1; }
    100% { opacity: 0; }
  }

  @keyframes shade-back {
    0% { opacity: 0; }
    30% { opacity: 1; }
    100% { opacity: 0; }
  }

  .flipbook__edge {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 24%;
    z-index: 6;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .flipbook__edge--prev { left: 0; }
  .flipbook__edge--next { right: 0; }
  .flipbook__edge[disabled] { cursor: default; }

  .flipbook__controls {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding-top: var(--space-6);
  }

  .flipbook__arrow {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--color-hairline);
    border-radius: 50%;
    background: none;
    cursor: pointer;
    color: var(--color-accent);
    transition:
      color var(--duration-fast, 160ms) ease,
      border-color var(--duration-fast, 160ms) ease,
      opacity var(--duration-fast, 160ms) ease;
  }

  .flipbook__arrow svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .flipbook__arrow:hover:not([disabled]) {
    color: var(--color-accent-hover);
    border-color: var(--color-accent);
  }

  .flipbook__arrow[disabled] {
    opacity: 0.3;
    cursor: default;
  }

  /* Scrub track: click or drag anywhere along it to go straight to a page. */
  .flipbook__slider {
    position: relative;
    flex: 1 1 auto;
    height: 2.75rem;
    cursor: pointer;
    touch-action: none;
  }

  .flipbook__rail,
  .flipbook__fill {
    position: absolute;
    top: 50%;
    left: 0;
    height: 2px;
    transform: translateY(-50%);
  }

  .flipbook__rail {
    width: 100%;
    background: var(--color-hairline);
  }

  .flipbook__fill {
    width: 0;
    background: var(--color-accent);
    transition: width 200ms ease;
  }

  .flipbook__ticks {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .flipbook__tick {
    width: 1px;
    height: 7px;
    background: var(--color-hairline);
  }

  .flipbook__knob {
    position: absolute;
    top: 50%;
    left: 0;
    width: 0.75rem;
    height: 0.75rem;
    margin-left: -0.375rem;
    border-radius: 50%;
    background: var(--color-accent);
    transform: translateY(-50%);
    transition: left 200ms ease;
  }

  .flipbook__slider:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .flipbook.is-scrubbing .flipbook__fill,
  .flipbook.is-scrubbing .flipbook__knob {
    transition: none;
  }

  .flipbook__count {
    padding-top: var(--space-3);
    text-align: center;
    font-family: var(--font-mono, var(--font-body));
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .flipbook__page[data-turning] .flipbook__leaf,
    .flipbook__page[data-turning] .flipbook__shade {
      animation-duration: 1ms;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-flipbook]').forEach((book) => {
    const pages = [...book.querySelectorAll<HTMLElement>('.flipbook__page')];
    const label = book.querySelector<HTMLElement>('[data-count-label]');
    const fill = book.querySelector<HTMLElement>('[data-fill]');
    const knob = book.querySelector<HTMLElement>('[data-knob]');
    const slider = book.querySelector<HTMLElement>('[data-slider]');
    const prevs = [...book.querySelectorAll<HTMLButtonElement>('[data-prev]')];
    const nexts = [...book.querySelectorAll<HTMLButtonElement>('[data-next]')];
    const total = pages.length;
    if (!total) return;

    const pad = (n: number) => String(n).padStart(2, '0');
    let index = 0;
    // The leaf currently mid-turn, if any. A new navigation finishes it on the
    // spot rather than being dropped — clicking ahead should always register.
    let turning: { page: HTMLElement; target: number } | null = null;

    const paintPages = () => {
      pages.forEach((page, i) => {
        page.dataset.state = i < index ? 'before' : i === index ? 'current' : 'after';
        if (Math.abs(i - index) <= 1) {
          const img = page.querySelector('img');
          if (img?.loading === 'lazy') img.loading = 'eager';
        }
      });
    };

    // The counter, track and buttons follow the page you're heading TO, and
    // update the moment you click — waiting for the turn to land would leave
    // them a page behind for over a second and read as an unresponsive click.
    const paintChrome = (shown: number) => {
      if (label) label.textContent = pad(shown + 1);
      const pct = total > 1 ? (shown / (total - 1)) * 100 : 0;
      if (fill) fill.style.width = `${pct}%`;
      if (knob) knob.style.left = `${pct}%`;
      slider?.setAttribute('aria-valuenow', String(shown + 1));
      prevs.forEach((b) => (b.disabled = shown === 0));
      nexts.forEach((b) => (b.disabled = shown === total - 1));
    };

    const paint = () => {
      paintPages();
      paintChrome(index);
    };

    const finishTurn = () => {
      if (!turning) return;
      delete turning.page.dataset.turning;
      index = turning.target;
      turning = null;
      paint();
    };

    const goTo = (target: number, animate: boolean) => {
      const next = Math.min(Math.max(target, 0), total - 1);
      // Whatever was mid-flight lands immediately, so this navigation starts
      // from a settled book instead of being swallowed.
      finishTurn();
      if (next === index) return;

      if (!animate || Math.abs(next - index) !== 1) {
        index = next;
        paint();
        return;
      }

      const forward = next > index;
      const page = forward ? pages[index] : pages[next];
      const beneath = pages[next];
      beneath.dataset.state = 'current';
      const img = beneath.querySelector('img');
      if (img?.loading === 'lazy') img.loading = 'eager';
      if (!forward) page.dataset.state = 'current';

      page.dataset.turning = forward ? 'forward' : 'back';
      turning = { page, target: next };
      paintChrome(next);

      const leaf = page.querySelector('.flipbook__leaf');
      const settle = () => {
        // Only finish if this is still the turn we started.
        if (turning?.page === page) finishTurn();
      };
      leaf?.addEventListener('animationend', settle, { once: true });
      // If the animation never fires (backgrounded tab, say), don't strand it.
      setTimeout(settle, 1400);
    };

    // Step from whatever the book is ALREADY heading to, not from where it
    // currently sits — otherwise a click landing mid-turn just re-targets the
    // page being turned to and looks like it did nothing.
    const go = (delta: number) => goTo((turning ? turning.target : index) + delta, true);

    prevs.forEach((b) => b.addEventListener('click', () => go(-1)));
    nexts.forEach((b) => b.addEventListener('click', () => go(1)));

    book.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
      if (e.key === 'Home') { e.preventDefault(); goTo(0, false); }
      if (e.key === 'End') { e.preventDefault(); goTo(total - 1, false); }
    });

    // Scrubbing: click or drag the track to land on a page directly.
    if (slider) {
      const indexAt = (clientX: number) => {
        const r = slider.getBoundingClientRect();
        const t = Math.min(Math.max((clientX - r.left) / r.width, 0), 1);
        return Math.round(t * (total - 1));
      };
      let scrubbing = false;
      slider.addEventListener('pointerdown', (e) => {
        scrubbing = true;
        book.classList.add('is-scrubbing');
        slider.setPointerCapture(e.pointerId);
        goTo(indexAt(e.clientX), false);
      });
      slider.addEventListener('pointermove', (e) => {
        if (scrubbing) goTo(indexAt(e.clientX), false);
      });
      const stop = () => {
        scrubbing = false;
        book.classList.remove('is-scrubbing');
      };
      slider.addEventListener('pointerup', stop);
      slider.addEventListener('pointercancel', stop);
    }

    let startX = 0;
    let startY = 0;
    book.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
    }, { passive: true });
    book.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) go(dx < 0 ? 1 : -1);
    }, { passive: true });

    paint();
  });
</script>
