---
// Full-bleed dark block: intro paragraph + a numbered, hairline-divided
// fact sheet (Affiliation, Project Type, Site Area, GFA, ...). Adapts the
// PRB reference site's dark "numbered scope list" panel to Vanessa's own
// project fact-sheet structure from her PDF portfolio.
interface Facts {
  affiliation?: string;
  client?: string;
  projectType?: string;
  currentStage?: string;
  siteArea?: string;
  gfa?: string;
  projectCost?: string;
  program?: string;
  units?: string;
  responsibilities?: string;
  fullRead?: string;
}
interface Props {
  description: string;
  facts?: Facts;
  /** One attribution line for the project's firm/developer-supplied imagery
   *  (e.g. "Images Courtesy of RWA Group Architecture"). Rendered once, quietly,
   *  at the bottom-right of the fact sheet — right-aligned to the same edge the
   *  fact rows end on — instead of repeating under every image on the page. */
  credit?: string;
}
const { description, facts, credit } = Astro.props;

// A fact value that's a URL renders as a clickable link instead of plain text.
// Link text reads from the destination host (e.g. "View on Behance ↗") so it's
// friendlier than a raw URL, and stays generic for any future link.
const isUrl = (v: string) => /^https?:\/\//.test(v);
const linkLabel = (url: string) => {
  try {
    const host = new URL(url).hostname.replace(/^www\./, '');
    if (host.includes('behance')) return 'View on Behance ↗';
    if (host.includes('issuu')) return 'View on Issuu ↗';
    return 'Read the full project ↗';
  } catch {
    return 'Read the full project ↗';
  }
};

// Responsibilities is deliberately excluded here — it gets its own
// highlighted "Vanessa's Role" section (see RoleHighlight.astro) since it's
// specifically her personal contribution, not a general project fact.
const rows = [
  ['Affiliation', facts?.affiliation],
  ['Client', facts?.client],
  ['Project Type', facts?.projectType],
  ['Current Stage', facts?.currentStage],
  ['Site Area', facts?.siteArea],
  ['GFA', facts?.gfa],
  ['Project Cost', facts?.projectCost],
  ['Program', facts?.program],
  ['No. of Units', facts?.units],
  ['Full Read', facts?.fullRead],
].filter(([, value]) => Boolean(value)) as [string, string][];
---

<section class="fact-block">
  <div class="container">
    <p class="fact-block__intro">{description.split('\n').map((line, i) => (<>{i > 0 && <br />}{line}</>))}</p>

    <div class="fact-block__list">
      <hr class="hairline hairline--dark" />
      {
        rows.map(([label, value], i) => (
          <>
            <div class="fact-block__row">
              <span class="fact-block__index">{String(i + 1).padStart(2, '0')}</span>
              <span class="fact-block__label">{label}</span>
              <span class="fact-block__value">
                {isUrl(value) ? (
                  <a class="fact-block__link" href={value} target="_blank" rel="noopener noreferrer">
                    {linkLabel(value)}
                  </a>
                ) : (
                  value
                )}
              </span>
            </div>
            <hr class="hairline hairline--dark" />
          </>
        ))
      }
    </div>

    {credit && <p class="fact-block__credit">{credit}</p>}
  </div>
</section>

<style>
  .fact-block {
    background: var(--color-dark-bg);
    color: var(--color-dark-text);
    padding-block: var(--space-16);
  }

  .fact-block__intro {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.3;
    /* Stretch to the full container width, matching the fact rows below and
       the images elsewhere on the page — a capped reading measure here left
       a large dead gap on the right on wide screens. */
    max-width: none;
    margin-bottom: var(--space-16);
  }

  .fact-block__row {
    display: grid;
    grid-template-columns: 2rem 12rem 1fr;
    gap: var(--space-4);
    align-items: baseline;
    padding-block: var(--space-4);
  }

  .fact-block__index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-dark-muted);
  }

  .fact-block__label {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-dark-muted);
  }

  .fact-block__value {
    font-size: var(--text-base);
  }

  .fact-block__link {
    color: var(--color-dark-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .fact-block__link:hover {
    color: var(--color-accent);
  }

  /* Closes the fact sheet: one quiet attribution line, right-aligned so it
     finishes flush with the end of the fact rows above it. Deliberately a step
     below the fact values in size and weight — it's metadata about the page's
     imagery, not another fact about the project. */
  .fact-block__credit {
    margin-top: var(--space-4);
    text-align: right;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-dark-muted);
  }

  @media (max-width: 40rem) {
    .fact-block__row {
      grid-template-columns: 1.5rem 1fr;
      grid-template-areas: 'index label' 'value value';
    }
    .fact-block__index {
      grid-area: index;
    }
    .fact-block__label {
      grid-area: label;
    }
    .fact-block__value {
      grid-area: value;
      padding-top: var(--space-1);
    }
  }
</style>
