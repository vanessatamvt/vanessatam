---
// Full-bleed dark block: intro paragraph + a numbered, hairline-divided
// fact sheet (Affiliation, Project Type, Site Area, GFA, ...). Adapts the
// PRB reference site's dark "numbered scope list" panel to Vanessa's own
// project fact-sheet structure from her PDF portfolio.
interface Facts {
  affiliation?: string;
  projectType?: string;
  currentStage?: string;
  siteArea?: string;
  gfa?: string;
  projectCost?: string;
  program?: string;
  responsibilities?: string;
}
interface Props {
  description: string;
  facts?: Facts;
}
const { description, facts } = Astro.props;

// Responsibilities is deliberately excluded here — it gets its own
// highlighted "Vanessa's Role" section (see RoleHighlight.astro) since it's
// specifically her personal contribution, not a general project fact.
const rows = [
  ['Affiliation', facts?.affiliation],
  ['Project Type', facts?.projectType],
  ['Current Stage', facts?.currentStage],
  ['Site Area', facts?.siteArea],
  ['GFA', facts?.gfa],
  ['Project Cost', facts?.projectCost],
  ['Program', facts?.program],
].filter(([, value]) => Boolean(value)) as [string, string][];
---

<section class="fact-block">
  <div class="container">
    <p class="fact-block__intro">{description}</p>

    <div class="fact-block__list">
      <hr class="hairline hairline--dark" />
      {
        rows.map(([label, value], i) => (
          <>
            <div class="fact-block__row">
              <span class="fact-block__index">{String(i + 1).padStart(2, '0')}</span>
              <span class="fact-block__label">{label}</span>
              <span class="fact-block__value">{value}</span>
            </div>
            <hr class="hairline hairline--dark" />
          </>
        ))
      }
    </div>
  </div>
</section>

<style>
  .fact-block {
    background: var(--color-dark-bg);
    color: var(--color-dark-text);
    padding-block: var(--space-16);
  }

  .fact-block__intro {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.3;
    max-width: 46rem;
    /* Indent the first line, echoing the PRB reference page's intro paragraph treatment */
    text-indent: 2em;
    margin-bottom: var(--space-16);
  }

  .fact-block__row {
    display: grid;
    grid-template-columns: 2rem 12rem 1fr;
    gap: var(--space-4);
    align-items: baseline;
    padding-block: var(--space-4);
  }

  .fact-block__index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-dark-muted);
  }

  .fact-block__label {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-dark-muted);
  }

  .fact-block__value {
    font-size: var(--text-base);
  }

  @media (max-width: 40rem) {
    .fact-block__row {
      grid-template-columns: 1.5rem 1fr;
      grid-template-areas: 'index label' 'value value';
    }
    .fact-block__index {
      grid-area: index;
    }
    .fact-block__label {
      grid-area: label;
    }
    .fact-block__value {
      grid-area: value;
      padding-top: var(--space-1);
    }
  }
</style>
