---
const email = 'vanessatamvt@gmail.com';
---

<div id="menu-overlay" class="menu-overlay" aria-hidden="true">
  <div class="container menu-overlay__top">
    <button type="button" id="menu-close" class="menu-overlay__close">Close</button>
  </div>
  <hr class="hairline hairline--dark" />

  <nav class="container menu-overlay__nav">
    <a href="/about" class="menu-overlay__link">
      <span>About</span>
      <span aria-hidden="true" class="menu-overlay__arrow menu-overlay__arrow--ne">&nearr;</span>
    </a>
    <hr class="hairline hairline--dark" />
    <a href="/" class="menu-overlay__link">
      <span>Work</span>
      <span aria-hidden="true" class="menu-overlay__arrow menu-overlay__arrow--e">&nearr;</span>
    </a>
    <hr class="hairline hairline--dark" />
    <a href="/photo-journal" class="menu-overlay__link">
      <span>Photo-Journal</span>
      <span aria-hidden="true" class="menu-overlay__arrow menu-overlay__arrow--s">&nearr;</span>
    </a>
    <hr class="hairline hairline--dark" />
    <a href="/contact" class="menu-overlay__link">
      <span>Contact</span>
      <span aria-hidden="true" class="menu-overlay__arrow menu-overlay__arrow--se">&nearr;</span>
    </a>
    <hr class="hairline hairline--dark" />
  </nav>

  <div class="container menu-overlay__bottom">
    <p class="menu-overlay__tagline">Architecture | Photography</p>
  </div>
</div>

<style>
  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--color-dark-bg);
    color: var(--color-dark-text);
    display: flex;
    flex-direction: column;
    transform: translateY(-100%);
    transition: transform var(--duration-slow) var(--ease-standard);
  }

  .menu-overlay.is-open {
    transform: translateY(0);
  }

  .menu-overlay__top {
    display: flex;
    justify-content: flex-end;
    padding-block: var(--space-4);
  }

  .menu-overlay__close {
    font-size: var(--text-sm);
  }

  .menu-overlay__nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--space-8);
  }

  .menu-overlay__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 500;
    padding-block: var(--space-4);
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .menu-overlay__link:hover {
    opacity: 0.6;
  }

  .menu-overlay__arrow {
    display: inline-block;
  }
  .menu-overlay__arrow--ne {
    transform: rotate(0deg);
  }
  .menu-overlay__arrow--e {
    transform: rotate(45deg);
  }
  .menu-overlay__arrow--se {
    transform: rotate(90deg);
  }
  .menu-overlay__arrow--s {
    transform: rotate(135deg);
  }

  .menu-overlay__bottom {
    display: flex;
    justify-content: flex-end;
    padding-block: var(--space-6);
  }

  .menu-overlay__tagline {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-dark-muted);
  }
</style>

<script>
  function bindMenu() {
    const overlay = document.getElementById('menu-overlay');
    const openBtn = document.getElementById('menu-toggle');
    const closeBtn = document.getElementById('menu-close');
    if (!overlay || !openBtn || !closeBtn) return;

    const open = () => {
      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);

    overlay.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        const linkPath = new URL(link.href, location.origin).pathname;
        if (linkPath === location.pathname) {
          close();
        } else {
          sessionStorage.setItem('menuNav', '1');
        }
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });

    if (sessionStorage.getItem('menuNav')) {
      sessionStorage.removeItem('menuNav');
      const main = document.querySelector('main');
      if (main) {
        requestAnimationFrame(() => {
          main.style.transition = 'transform var(--duration-slow) var(--ease-standard)';
          main.style.transform = 'translateY(0)';
          overlay.classList.remove('is-open');
          overlay.setAttribute('aria-hidden', 'true');

          main.addEventListener('transitionend', () => {
            main.style.transition = '';
            main.style.transform = '';
            document.body.style.overflow = '';
          }, { once: true });
        });
      }
    }
  }

  document.addEventListener('astro:after-swap', () => {
    if (sessionStorage.getItem('menuNav')) {
      const overlay = document.getElementById('menu-overlay');
      const main = document.querySelector('main');
      if (overlay) {
        overlay.classList.add('is-open');
        overlay.setAttribute('aria-hidden', 'false');
      }
      if (main) {
        main.style.transform = 'translateY(100vh)';
      }
      document.body.style.overflow = 'hidden';
    }
  });

  document.addEventListener('astro:page-load', bindMenu);
</script>
