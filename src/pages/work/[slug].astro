---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import FactList from '../../components/FactList.astro';
import RoleHighlight from '../../components/RoleHighlight.astro';
import PageFlipbook from '../../components/PageFlipbook.astro';
import ProjectSection from '../../components/ProjectSection.astro';
import BuildingGallery from '../../components/BuildingGallery.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, allProjects: projects },
  }));
}

const { project, allProjects } = Astro.props;
const {
  title,
  location,
  category,
  code,
  description,
  facts,
  heroImage,
  detailHeroImage,
  heroPosition,
  heroContain,
  imageZoom,
  sections,
  buildingGallery,
  galleryTitle,
  galleryCredit,
  galleryLandscape,
  galleryMixed,
  galleryBeforeSections,
  galleryTight,
  constructionGallery,
  constructionGalleryTitle,
  constructionGalleryLandscape,
  constructionGalleryMixed,
  finaleImage,
  finaleCaption,
  imageCredit,
} = project.data;
const { Content } = await render(project);
const hasBody = project.body != null && project.body.trim().length > 0;

// The project page's own banner can show a different, larger photo than the
// home page card (detailHeroImage) — ProjectCard.astro (the home page card)
// always uses heroImage directly and is untouched by this. Falls back to
// heroImage when detailHeroImage isn't set.
const pageHeroImage = detailHeroImage ?? heroImage;

const related = allProjects
  .filter((p) => p.id !== project.id)
  .sort((a, b) => {
    if (a.data.category !== b.data.category) return a.data.category === 'professional' ? -1 : 1;
    return a.data.code.localeCompare(b.data.code);
  })
  .slice(0, 3);

// Never ask the image pipeline for a width wider than the source photo has.
// The hero renders at up to 100vw, so on a wide desktop screen the browser
// picks the largest srcset entry — if that entry was upscaled past the
// source's real resolution (some heroes are narrower phone photos, e.g.
// portrait shots under 2000px wide), the result is a soft/blurry hero even
// though the original file is fine. Capping the candidates to the source's
// intrinsic width means the browser's own upscaling is the only one that
// ever happens, instead of stacking Astro's upscale on top of it.
const heroWidthCandidates = [640, 1024, 1600, 2000].filter((w) => w <= pageHeroImage.width);
// The source's own width goes in the set too: without it, a 1666px-wide image
// tops out at the 1600 candidate and the browser scales that up to fill the
// banner, which is exactly the softness the cap above exists to prevent. It's
// capped at 2600 so an oversized source (a 7000px export, say) can't make the
// pipeline render a 7000px variant nobody will ever see.
const heroWidths = [
  ...new Set([...heroWidthCandidates, Math.min(pageHeroImage.width, 2600)]),
].sort((a, b) => a - b);
// An uncropped hero is laid out at its own size (capped to the viewport) rather
// than stretched across it, so the browser never has to upscale it at all.
const heroSizes = heroContain ? `min(100vw, ${pageHeroImage.width}px)` : '100vw';
---

<BaseLayout title={title} description={description} headerVariant="project">
  <article>
    <section class="project-hero">
      <div class="container project-hero__inner">
        <div class="project-hero__label">
          <SectionLabel text={`${category === 'professional' ? 'Professional' : 'Academic'} Project ${code}`} />
        </div>
        <div class="project-hero__copy">
          <h1 class="project-hero__title">{title}</h1>
          <p class="project-hero__location">{location}</p>
        </div>
        <span class="project-hero__arrow" aria-hidden="true">&searr;</span>
      </div>
    </section>

    <hr class="hairline" />

    <figure class="project-hero__image-wrap">
      <Image src={pageHeroImage} alt={title} widths={heroWidths} sizes={heroSizes} loading="eager" fetchpriority="high" class:list={['project-hero__image', { 'project-hero__image--contain': heroContain }]} style={heroPosition && !heroContain ? `object-position: ${heroPosition};` : undefined} />
    </figure>

    <FactList description={description} facts={facts} credit={imageCredit} />
    <RoleHighlight responsibilities={facts?.responsibilities} details={facts?.responsibilityDetails} />

    {
      hasBody && (
        <div class="container project-body">
          <Content />
        </div>
      )
    }

    {/* galleryBeforeSections is an opt-in per-project override — everyone else
        keeps the default order below (sections, then buildingGallery). */}
    {galleryBeforeSections && buildingGallery.length > 0 && (
      <BuildingGallery images={buildingGallery} title={galleryTitle} landscape={galleryLandscape} mixed={galleryMixed} credit={galleryCredit} tight={galleryTight} />
    )}

    <div class="project-sections">
      {
        sections.map((section) =>
          section.flipbook && section.flipbook.length > 0 ? (
            <PageFlipbook pages={section.flipbook} title={section.flipbookTitle} />
          ) : (
          <ProjectSection
            images={section.images}
            sharedCaption={section.sharedCaption}
            zoom={imageZoom === true}
            featuredIndex={section.featuredIndex}
            text={section.text}
            grid={section.grid}
            narrow={section.narrow}
            textBeside={section.textBeside}
            compact={section.compact}
            note={section.note}
            smallText={section.smallText}
            captionText={section.captionText}
            leadText={section.leadText}
            video={section.video}
            videoBanner={section.videoBanner}
            autoplay={section.autoplay}
          />
        ))
      }
    </div>

    {/* Rendered after the story sections so a project can lead with content
        (e.g. a video) and close with the showcase carousel. Projects with no
        sections (e.g. Eastward) are unaffected — the gallery just follows the
        facts as before. constructionGallery always renders last, regardless
        of galleryBeforeSections. */}
    {!galleryBeforeSections && buildingGallery.length > 0 && (
      <BuildingGallery images={buildingGallery} title={galleryTitle} landscape={galleryLandscape} mixed={galleryMixed} credit={galleryCredit} tight={galleryTight} />
    )}
    {constructionGallery.length > 0 && <BuildingGallery images={constructionGallery} title={constructionGalleryTitle} landscape={constructionGalleryLandscape} mixed={constructionGalleryMixed} />}

    {/* The page's closing shot — deliberately placed after BOTH carousels so it
        reads as a finale rather than as another item in the reel. Rendered
        through <ProjectSection /> so it inherits the exact single-image
        treatment (width, caption style, lightbox) used in the story above. */}
    {
      finaleImage && (
        <div class="project-finale">
          <ProjectSection images={[{ src: finaleImage, caption: finaleCaption }]} zoom={imageZoom === true} />
        </div>
      )
    }

    <section class="related">
      <hr class="hairline" />
      <div class="container">
        <p class="meta-label related__heading">More Projects</p>
        {
          related.map((p) => (
            <>
              <a href={`/work/${p.id}`} class="related__row">
                <span class="meta-label related__code">PROJECT {p.data.code}</span>
                <span class="related__title">{p.data.title}</span>
                <span aria-hidden="true">&nearr;</span>
              </a>
              <hr class="hairline" />
            </>
          ))
        }
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .project-hero {
    padding-block: var(--space-16) var(--space-8);
  }

  .project-hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: var(--space-4);
  }

  .project-hero__title {
    font-size: var(--text-hero);
    /* Reserve room on the right for the decorative arrow so long single-line
       titles (e.g. "Un Po' Più di Boschi") don't crowd into it. */
    padding-right: clamp(2.5rem, 6vw, 5rem);
  }

  .project-hero__location {
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin-top: var(--space-4);
  }

  .project-hero__arrow {
    position: absolute;
    top: 0;
    right: var(--container-padding);
    font-size: var(--text-2xl);
    color: var(--color-accent);
  }

  .project-hero__image {
    width: 100%;
    height: auto;
    max-height: 85vh;
    object-fit: cover;
  }

  /* Uncropped hero (heroContain): shown whole, at its own pixel dimensions and
     centred, capped to the viewport width. Nothing is cropped and nothing is
     enlarged past the source, so a drawing or masterplan rendering keeps both
     its full composition and its sharpness. */
  .project-hero__image--contain {
    object-fit: contain;
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: none;
    margin-inline: auto;
  }

  .project-hero__caption {
    padding-block: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-align: left;
  }

  .project-body {
    padding-block: var(--space-16);
    /* Fluid measure: grows with the window instead of a frozen 46rem. */
    max-width: var(--text-measure);
    font-size: var(--text-lg);
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .project-sections {
    padding-bottom: var(--space-16);
  }


  /* Breathing room between the last carousel and the closing image, so the
     finale reads as its own beat rather than trailing the reel. */
  .project-finale {
    padding-block: var(--space-16);
  }

  .related__heading {
    padding-block: var(--space-6) var(--space-3);
  }

  .related__row {
    display: flex;
    align-items: baseline;
    gap: var(--space-6);
    padding-block: var(--space-4);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .related__row:hover {
    color: var(--color-accent);
  }

  .related__code {
    width: 4.5rem;
    flex-shrink: 0;
  }

  .related__title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    flex: 1;
  }
</style>
