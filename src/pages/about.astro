---

<BaseLayout
  title="About"
  description="Vanessa Tam — UK-registered Architect (ARB) and Vancouver-based Project Designer, with experience spanning Canada, Hong Kong and Italy."
  headerVariant="project"
  backLabel="Work"
  backHref="/"
>
  <article>
    <section class="about-top">
      <div class="container about-top__inner">
        <div class="about-top__label">
          <SectionLabel text="About" />
        </div>
        <div class="about-top__copy">
          <h1 class="about-top__name">Vanessa Tam</h1>
          <p class="about-top__credential">Architect — ARB, UK</p>
          <div class="about-top__contact">
            <a href={`mailto:${email}`}>{email}</a>
            <a href={`tel:${phone.replace(/[^0-9+]/g, '')}`} class="about-top__phone">{phone}</a>
            <span>{location}</span>
            <a href={pdfHref} class="about-top__download" download>
              Download PDF <span aria-hidden="true">&darr;</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Opening statement: a solid accent panel beside the bio's first
         paragraph, set large. The panel is a placeholder for a portrait —
         set `portrait` above to an imported image and it swaps in. -->
    <section class="statement">
      <div class="container statement__grid">
        <div class="statement__panel">
          {portrait ? <Image src={portrait} alt="Vanessa Tam" widths={[480, 900, 1300]} sizes="(min-width: 60rem) 34vw, 90vw" loading="eager" /> : null}
        </div>
        <div class="statement__right">
          <p class="statement__text">{statement}</p>

          <!-- The walk sits in the dead space beside the panel, pushed to the
               bottom of the column so its dotted ground line lands on the
               panel's bottom edge. Free scrolling, no snap: it should feel like
               panning along a wall, not stepping through slides. -->
          <section class="evolution" aria-label="From crawling to construction site">
            <div class="evolution__rail" data-evolution-rail tabindex="0">
              <div class="evolution__strip">
                {
                  figures.map((fig) => (
                    <div class="evolution__figure" style={`--fig-ratio:${fig.ratio}`}>
                      <Image src={fig.src} alt="" loading="lazy" />
                    </div>
                  ))
                }
              </div>
            </div>
            <button type="button" class="evolution__arrow" data-evolution-scroll aria-label="Scroll sketch">&rarr;</button>
          </section>
        </div>
      </div>
    </section>

    <section class="container lead">
      <p class="lead__text">{lead}</p>
    </section>

    <div class="blocks container">
      <!-- Education -->
      <section class="block">
        <h2 class="block__title">Education</h2>
        <p class="block__tags">Italy / Hong Kong</p>
        <hr class="hairline block__rule" />
        <div class="block__body">
          {
            education.map((entry) => (
              <div class="entry">
                <div class="entry__when">
                  <span class="entry__years">{entry.years}</span>
                  <span class="entry__place">{entry.place}</span>
                </div>
                <div class="entry__what">
                  <h3 class="entry__role entry__role--sm">{entry.role}</h3>
                  <p class="entry__org">{entry.org}</p>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <p class="blocks__interlude">{practiceIntro}</p>

      <!-- Professional Experience. The entry format is unchanged from before:
           every project named here links to its own project page. -->
      <section class="block">
        <h2 class="block__title">Professional Experience</h2>
        <p class="block__tags">Vancouver / Hong Kong / Shanghai</p>
        <hr class="hairline block__rule" />
        <div class="block__body">
          {
            experience.map((entry) => (
              <div class="entry">
                <div class="entry__when">
                  <span class="entry__years">{entry.years}</span>
                  <span class="entry__place">{entry.place}</span>
                </div>
                <div class="entry__what">
                  <h3 class="entry__role">{entry.role}</h3>
                  <p class="entry__org">{entry.org}</p>
                  {entry.items && (
                    <ul class="items">
                      {entry.items.map((item) => (
                        <li class="items__item">
                          {item.href ? (
                            <a href={item.href} class="items__link">
                              {item.text}
                              <span aria-hidden="true" class="items__arrow">
                                &nearr;
                              </span>
                            </a>
                          ) : (
                            <span>{item.text}</span>
                          )}
                          {item.note && <span class="items__note">{item.note}</span>}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Certifications -->
      <section class="block">
        <h2 class="block__title">Certifications</h2>
        <hr class="hairline block__rule block__rule--no-tags" />
        <div class="block__body">
          {
            certifications.map(([year, name, issuer]) => (
              <div class="line">
                <span class="line__key">{year}</span>
                <span class="line__value">
                  {name}
                  <span class="line__note">{issuer}</span>
                </span>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Skills -->
      <section class="block">
        <h2 class="block__title">Skills</h2>
        <p class="block__tags">Digital Skills / Languages</p>
        <hr class="hairline block__rule" />
        <div class="block__body">
          {
            skills.map(([label, value]) => (
              <div class="line">
                <span class="line__key">{label}</span>
                <span class="line__value">
                  {value.split('\n').map((part, i) => (
                    <>
                      {i > 0 && <br />}
                      {part}
                    </>
                  ))}
                </span>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Extra-Curriculars -->
      <section class="block">
        <h2 class="block__title">Extra-Curriculars</h2>
        <p class="block__tags">Community / Non-Profit / Further Education</p>
        <hr class="hairline block__rule" />
        <div class="block__body">
          {
            extras.map((item) => (
              <div class="line">
                <span class="line__key">{item.years}</span>
                <span class="line__value">
                  {item.href ? (
                    <a href={item.href} class="items__link">
                      {item.text}
                      <span aria-hidden="true" class="items__arrow">
                        &nearr;
                      </span>
                    </a>
                  ) : (
                    item.text
                  )}
                  {item.note && <span class="line__note">{item.note}</span>}
                </span>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  /* --- Top strip: name, credential, how to reach her --------------------- */
  .about-top {
    padding-block: var(--space-16) var(--space-8);
  }

  .about-top__inner {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: var(--space-4);
  }

  .about-top__name {
    font-size: var(--text-2xl);
  }

  /* The registration is the headline credential, so it sits directly under the
     name in the accent colour rather than buried in the certifications list. */
  .about-top__credential {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-top: var(--space-3);
  }

  .about-top__contact {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .about-top__contact a {
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .about-top__contact a:hover {
    color: var(--color-accent);
  }

  /* Every glyph in a monospace face carries the same advance width, so the two
     spaces bracketing the area code read as wide gaps. Negative word-spacing
     tightens exactly those two spaces and nothing else — the hyphen isn't one. */
  .about-top__phone {
    word-spacing: -0.28em;
  }

  .about-top__download {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  /* --- Opening statement ------------------------------------------------- */
  .statement {
    padding-block: var(--space-8) var(--space-16);
  }

  .statement__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.3fr);
    gap: clamp(var(--space-8), 5vw, var(--space-24));
    /* stretch, not start: the right column has to match the panel's height so
       the walk can be pushed to its floor. */
    align-items: stretch;
  }

  /* Statement at the top, walk pinned to the bottom — that's what lines the
     walk's ground line up with the panel's bottom edge. min-width:0 lets the
     rail shrink inside the grid track so it can actually scroll. */
  .statement__right {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-8);
    min-width: 0;
  }

  /* Square accent panel standing in for a portrait. It keeps its shape whether
     or not an image is dropped in, so the composition doesn't move later. */
  .statement__panel {
    aspect-ratio: 1;
    background: var(--color-accent);
    overflow: hidden;
    /* How far to the right the square is taken from the photograph.
       A 2:3 frame in a square panel has NO horizontal slack under
       object-fit: cover — the full width is already showing — so the image is
       widened by this much and pulled back by the same amount. The face moves
       roughly a third of this value towards the centre, because widening the
       image pushes it right again; 15% here lands it ~5% more centred, at the
       cost of the leftmost ~13% of the hillside. Set to 0 to undo. */
    --portrait-pan: 0%;
  }

  .statement__panel :global(img) {
    width: calc(100% + var(--portrait-pan));
    /* global.css caps every img at max-width:100%, which would swallow the
       extra width the pan needs and leave a gap on the right instead. */
    max-width: none;
    margin-left: calc(-1 * var(--portrait-pan));
    height: 100%;
    object-fit: cover;
    display: block;
    /* A square cut from a 2:3 frame only has vertical room to move, and the
       centre of this one lands on empty hillside. Taking the square from the
       foot of the frame puts the face in the upper third with the shoulders
       anchoring the bottom edge. Change the second value to re-frame. */
    object-position: 50% 100%;
  }

  .statement__text {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2.45vw, 2.15rem);
    font-weight: 500;
    line-height: 1.25;
  }

  /* --- Lead paragraph ---------------------------------------------------- */
  .lead {
    padding-block: var(--space-8) var(--space-16);
  }

  .lead__text {
    font-size: var(--text-lg);
    line-height: 1.5;
    /* No capped measure: the paragraph runs the full container width, so it
       re-wraps continuously as the window is dragged wider or narrower and
       finishes flush with the right margin like everything around it. */
    max-width: none;
  }

  /* --- The walk ---------------------------------------------------------- */
  .evolution {
    /* No background of its own — the page's cream shows through the drawing's
       transparent PNGs, so the strip sits ON the site rather than in a box.
       No padding either: the strip's own bottom edge IS the ground line, and it
       has to sit flush with the bottom of the accent panel beside it. */
    padding: 0;
    /* Makes cqw below resolve against this rail's width rather than the
       viewport, so the figures are sized by the column they live in. */
    container-type: inline-size;
  }

  .evolution__rail {
    position: relative;
    overflow-x: auto;
    /* Deliberately NO scroll-snap: this should pan like a wall, not step
       between slides. */
    scrollbar-width: none;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .evolution__rail::-webkit-scrollbar {
    display: none;
  }

  .evolution__rail.is-dragging {
    cursor: grabbing;
  }

  .evolution__strip {
    /* Every figure's width works out as --walk-h x (its own pixel width / 760),
       so the six come to 2.11 x --walk-h laid end to end. At 34cqw with gaps of
       0.35, four figures and their gaps fill the rail and the fifth is cut in
       half — the "four and a half figures" before you have to scroll. */
    --walk-h: 34cqw;
    --walk-gap: calc(var(--walk-h) * 0.35);
    display: flex;
    align-items: flex-end;
    gap: var(--walk-gap);
    width: max-content;
  }

  .evolution__figure {
    flex: 0 0 auto;
    position: relative;
    height: calc(var(--walk-h) * var(--fig-ratio, 1));
  }

  /* A dotted trace at foot level joining one figure to the next — drawn only
     across the gaps, not continuously beneath the figures, so it reads as the
     path walked rather than a floor they're standing on. Each figure paints the
     segment to its right; the last one has nowhere to walk to. */
  .evolution__figure:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 100%;
    bottom: 0;
    width: var(--walk-gap);
    border-top: 1px dotted rgba(28, 26, 22, 0.45);
  }

  .evolution__figure :global(img) {
    height: 100%;
    width: auto;
    display: block;
    -webkit-user-drag: none;
  }

  .evolution__arrow {
    display: block;
    margin-left: auto;
    font-size: var(--text-lg);
    font-weight: 400;
    color: var(--color-accent);
    padding-top: var(--space-3);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .evolution__arrow:hover {
    color: var(--color-accent-hover);
  }

  /* --- Titled blocks ----------------------------------------------------- */
  .blocks {
    padding-bottom: var(--space-16);
  }

  .block {
    padding-block: var(--space-12);
  }

  /* The third bio paragraph, sitting between Education and Professional
     Experience — spaced like a block but without a heading of its own. */
  .blocks__interlude {
    font-size: var(--text-lg);
    line-height: 1.5;
    padding-block: var(--space-8) var(--space-4);
  }

  .block__title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 500;
  }

  .block__tags {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink);
    margin-top: var(--space-3);
  }

  .block__rule {
    margin-top: var(--space-2);
  }

  /* Certifications carries no tag line, so its rule needs the breathing room
     the tags would otherwise have provided. */
  .block__rule--no-tags {
    margin-top: var(--space-6);
  }

  .block__body {
    padding-top: var(--space-8);
    max-width: 58rem;
  }

  /* --- Dated entries (education, experience) ----------------------------- */
  .entry {
    display: grid;
    grid-template-columns: 13rem 1fr;
    gap: var(--space-6);
    padding-block: var(--space-6);
  }

  .entry + .entry {
    border-top: var(--hairline-width) solid var(--color-hairline);
  }

  .entry__when {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .entry__place {
    font-size: var(--text-xs);
  }

  .entry__role {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.25;
  }

  /* Degree titles run long — a step down keeps them from reading louder than
     the job titles in the section above. */
  .entry__role--sm {
    font-size: var(--text-base);
  }

  .entry__org {
    font-size: var(--text-base);
    color: var(--color-muted);
    margin-top: var(--space-2);
  }

  .items {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    /* Each project is two lines now, so the gap between them has to be clearly
       bigger than the gap between a title and its own note. */
    gap: var(--space-4);
  }

  /* Every project takes the same two-line shape — title, then its note on the
     line below — so the titles read as one clean vertical list. The previous
     flex row only wrapped when it ran out of room, which left short notes
     inline and long ones dropped, and the ragged mix looked accidental. */
  .items__item {
    display: block;
    font-size: var(--text-base);
  }

  /* A project named here is a door into its own page, so it gets the same
