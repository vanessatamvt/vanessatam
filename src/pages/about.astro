<script>
  // Press-and-drag panning for the walk, matching the home gallery and the
  // project carousels — trackpad swipe already works via native overflow
  // scrolling, this adds the mouse gesture.
  function bindEvolution() {
    const rail = document.querySelector<HTMLElement>('[data-evolution-rail]');
    if (!rail) return;

    // The figures are <img>, which the browser drags as images by default;
    // that gesture has to be cancelled or it pre-empts the pan.
    rail.addEventListener('dragstart', (e) => e.preventDefault());

    const DRAG_THRESHOLD = 6;
    let isDown = false;
    let dragging = false;
    let startX = 0;
    let startScroll = 0;

    rail.addEventListener('pointerdown', (e) => {
      isDown = true;
      dragging = false;
      startX = e.clientX;
      startScroll = rail.scrollLeft;
    });
    rail.addEventListener('pointermove', (e) => {
      if (!isDown) return;
      const dx = e.clientX - startX;
      if (!dragging && Math.abs(dx) > DRAG_THRESHOLD) {
        dragging = true;
        rail.classList.add('is-dragging');
        rail.setPointerCapture(e.pointerId);
      }
      if (dragging) rail.scrollLeft = startScroll - dx;
    });
    const stopDrag = () => {
      isDown = false;
      dragging = false;
      rail.classList.remove('is-dragging');
    };
    rail.addEventListener('pointerup', stopDrag);
    rail.addEventListener('pointercancel', stopDrag);

    const scrollBtn = document.querySelector<HTMLButtonElement>('[data-evolution-scroll]');
    if (scrollBtn) {
      const step = () => {
        const atEnd = rail.scrollLeft >= rail.scrollWidth - rail.clientWidth - 10;
        if (atEnd) {
          rail.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          rail.scrollBy({ left: rail.clientWidth * 0.6, behavior: 'smooth' });
        }
      };
      scrollBtn.addEventListener('click', step);
    }
  }

  document.addEventListener('astro:page-load', bindEvolution);
</script>




