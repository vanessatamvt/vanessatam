const extras: { years: string; text: string; note?: string; href?: string }[] = [
  { years: '2020', text: 'IDEA League Urban Mobility Concept Program', note: 'Smart City Expo, online' },
  {
    years: '2019',
    text: 'International Workshop of Urban and Architectural Design, XII Edition',
    note: 'Lecco, Italy — the Ver-corso Visconti proposal',
    href: '/work/a03-ver-corso-visconti',
  },
  { years: '2017', text: 'Fun Under the Flyover', note: 'community project, Hong Kong' },
