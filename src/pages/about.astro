---
// About — the first item in the menu, ahead of Work. The page is Vanessa's CV;
// "About" is just the friendlier door into it. Note this is NOT the site's
// landing page: the project gallery (index.astro) is still what loads at "/",
// so the menu's first entry and the site's entry point differ on purpose.
//
// Layout follows the reference Vanessa supplied: a solid colour block beside a
// large opening statement, a shorter lead paragraph beneath it, then a run of
// titled blocks — each one a heading, a line of tiny tracked-out tags, a
// hairline, and the content below it.
//
// The thing that makes this a *portfolio* CV rather than a document: every
// project named under a role links to its own project page, so a reader can
// step sideways from the line on the résumé into the drawings behind it.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';

// The six figures of the "crawling to construction site" drawing, cut from the
// vector artwork in Vanessa's résumé PDF. Each was cropped to a SHARED
// baseline, so bottom-aligning them stands everyone on the same ground, and
// each carries the ratio of its own height to the tallest figure — that's what
// keeps the baby small and the architect tall instead of scaling them to match.
const figureModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/evolution/*.png',
  { eager: true },
);
const figureSources = Object.entries(figureModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);
const tallest = Math.max(...figureSources.map((src) => src.height));
const figures = figureSources.map((src) => ({ src, ratio: src.height / tallest }));

// Set this to an imported image to replace the colour block in the opening
// statement with a portrait; setting it back to null restores the flat accent
// panel. The panel is SQUARE and the photograph is a 2:3 portrait, so the crop
// is as much of the decision as the photograph — see `object-position` on
// `.statement__panel img` further down.
import portraitSrc from '../content/photo-journal/Portrait of me/DSCF3762.JPEG';

const portrait: ImageMetadata | null = portraitSrc;

const email = 'vanessatamvt@gmail.com';
const phone = '+1 (604) 362-3678';
const location = 'Vancouver, British Columbia';
const pdfHref = '/vanessa-tam-cv.pdf';

const statement =
  'Vanessa is a UK-registered Architect (ARB) and Vancouver-based Project Designer with 5+ years of professional experience spanning Canada, Hong Kong, and Italy.';

const lead =
  'Holding a Master’s from Politecnico di Milano, she excels in high-density residential developments and strategic urban design interventions. Currently driving multi-unit housing projects at RWA Group, she expertly navigates local building code frameworks, managing permit submissions and on-site inspections with local AHJs.';

const practiceIntro =
  'Specializing in construction administration from IFC to project occupancy, Vanessa provides top-tier firms with a rare combination of global design perspective, technical precision, and proven project delivery.';

type Entry = {
  years: string;
  role: string;
  org: string;
  place: string;
  items?: { text: string; note?: string; href?: string }[];
};

const experience: Entry[] = [
  {
    years: 'Feb 2024 — Present',
    role: 'Project Designer',
    org: 'RWA Group Architecture Ltd',
    place: 'Vancouver, Canada',
    items: [
      {
