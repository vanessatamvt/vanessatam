    ],
  },
  { years: '2015', role: 'Intern', org: 'P&T Architects and Engineers Ltd', place: 'Hong Kong' },
  { years: '2014', role: 'Intern', org: 'Kohn Pedersen Fox', place: 'Shanghai' },
