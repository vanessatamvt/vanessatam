---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MenuOverlay from '../components/MenuOverlay.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  headerVariant?: 'home' | 'project';
  backLabel?: string;
  backHref?: string;
  /** 'dark' runs the whole page — header and footer included — on the dark
   *  brown, with every word in the light beige. Used by the photo-journal
   *  chapter pages so nothing cream frames the photographs. It sets
   *  data-theme on <html>, which re-points the colour tokens in tokens.css;
   *  no component below needs to know about it. */
  theme?: 'light' | 'dark';
}
const {
  title,
  description,
  headerVariant = 'home',
  backLabel,
  backHref,
  theme = 'light',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title} — Vanessa Tam</title>

    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-ibm-plex-mono" />

    <ClientRouter />
  </head>
  <body>
    <Header variant={headerVariant} backLabel={backLabel} backHref={backHref} />
    <main transition:animate="fade">
      <slot />
    </main>
    <Footer />
    <MenuOverlay />
    <Analytics />
  </body>
</html>
